# What the dev pipeline reads about this project.
# Schema: ${CLAUDE_PLUGIN_ROOT}/docs/project-contract.md

spec_repo = "../NotificationsSpecs"
design_philosophy = "docs/change-discipline.md"

[test_phase]
# This repo's and NotificationsDeploy's gates, every touched image built by
# hand, the bridge's local live check, then both pushes and the Jenkins build
# this repo's starts, then the deployed checks: Argo CD deploys
# NotificationsDeploy's main to prd.
strategy = "docs/slice-test-plan.md"

[doc_phase]
plan = "docs/slice-doc-plan.md"

[push]
enabled = true

# No [devlock]: there is no dev instance to occupy.
